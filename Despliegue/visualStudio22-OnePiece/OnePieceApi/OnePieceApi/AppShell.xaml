<!-- AppShell.xaml -->
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:OnePieceApp.Views"
       x:Class="OnePieceApp.AppShell">
    <ShellContent Route="main" ContentTemplate="{DataTemplate views:MainPage}" />
    <ShellContent Route="characters" ContentTemplate="{DataTemplate views:CharactersPage}" />
    <ShellContent Route="detail" ContentTemplate="{DataTemplate views:CharacterDetailPage}" />
    <ShellContent Route="search" ContentTemplate="{DataTemplate views:SearchPage}" />
</Shell>
