<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:OnePieceApi.Views"
       x:Class="OnePieceApi.AppShell">
    <TabBar>
        <ShellContent Route="main" Title="Inicio" ContentTemplate="{DataTemplate views:MainPage}" />
        <ShellContent Route="characters" Title="Personajes" ContentTemplate="{DataTemplate views:CharactersPage}" />
        <ShellContent Route="search" Title="Buscar" ContentTemplate="{DataTemplate views:SearchPage}" />
    </TabBar>
</Shell>
