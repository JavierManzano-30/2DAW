<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OnePieceApi.ViewModels"
             xmlns:models="clr-namespace:OnePieceApi.Models"
             x:Class="OnePieceApi.Views.CharactersPage"
             x:Name="CharactersRoot"
             x:DataType="vm:CharactersViewModel"
             Title="Personajes">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">
        <Label Text="Personajes"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
               HorizontalOptions="Center" />
        <Label Text="Toca una carta para ver el detalle"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
               HorizontalOptions="Center"
               Grid.Row="1"/>
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           Grid.Row="2"/>
        <CollectionView ItemsSource="{Binding Characters}"
                        Grid.Row="2"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}"
                        ItemsLayout="VerticalList">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Character">
                    <Frame CornerRadius="18"
                           Padding="0"
                           Margin="6,8"
                           HasShadow="True"
                           BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                        <Grid RowDefinitions="140,Auto,Auto" ColumnDefinitions="*">
                            <Image Source="{Binding Image}"
                                   HeightRequest="140"
                                   Aspect="AspectFill"
                                   Grid.RowSpan="1"
                                   Grid.ColumnSpan="1"/>
                            <StackLayout Grid.Row="1" Padding="12,10,12,4" Spacing="4">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Tripulación: " />
                                            <Span Text="{Binding Crew}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Row="2" Padding="12,0,12,12" Spacing="2" Orientation="Horizontal" HorizontalOptions="Start">
                                <Label Text="Recompensa:" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                                <Label Text="{Binding Bounty}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                            </StackLayout>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.GoToDetailCommand, Source={x:Reference Name=CharactersRoot}}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Text="{Binding StatusMessage}"
               TextColor="{StaticResource Primary}"
               FontSize="16"
               HorizontalOptions="Center"
               Grid.Row="3"/>
    </Grid>
</ContentPage>
