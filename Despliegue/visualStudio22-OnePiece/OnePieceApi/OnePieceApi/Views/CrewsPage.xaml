<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OnePieceApi.ViewModels"
             xmlns:models="clr-namespace:OnePieceApi.Models"
             x:Class="OnePieceApi.Views.CrewsPage"
             x:Name="CrewsRoot"
             x:DataType="vm:CrewsViewModel"
             Title="Tripulaciones">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">
        <Label Text="Tripulaciones"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
               HorizontalOptions="Center" />
        <Label Text="Explora las bandas pirata"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
               HorizontalOptions="Center"
               Grid.Row="1"/>
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           Grid.Row="2"/>
        <CollectionView ItemsSource="{Binding Crews}"
                        Grid.Row="2"
                        SelectionMode="None"
                        ItemsLayout="VerticalList">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Crew">
                    <Frame CornerRadius="14"
                           Padding="0"
                           Margin="6,8"
                           HeightRequest="120"
                           HasShadow="True"
                           BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">
                        <Grid RowDefinitions="80,Auto" ColumnDefinitions="*">
                            <Image Source="{Binding Image}"
                                   HeightRequest="80"
                                   Aspect="AspectFill"
                                   Grid.RowSpan="1"
                                   Grid.ColumnSpan="1"/>
                            <StackLayout Grid.Row="1" Padding="12,6,12,10" Spacing="2">
                                <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Capitán: " />
                                            <Span Text="{Binding Captain}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Barco: " />
                                            <Span Text="{Binding Ship}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </StackLayout>
                        </Grid>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.GoToDetailCommand, Source={x:Reference Name=CrewsRoot}}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Text="{Binding StatusMessage}"
               TextColor="{StaticResource Primary}"
               FontSize="16"
               HorizontalOptions="Center"
               Grid.Row="3"/>
    </Grid>
</ContentPage>
