<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OnePieceApi.ViewModels"
             x:Class="OnePieceApi.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="One Piece">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="One Piece Explorer"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
            <Label Text="Consulta tu API desplegada en Azure para ver personajes y detalles."
                   FontSize="16"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />

            <Button Text="Personajes"
                    Command="{Binding GoToCharactersCommand}" />
            <Button Text="Buscar personajes"
                    Command="{Binding GoToSearchCommand}" />
            <Button Text="Tripulaciones"
                    Command="{Binding GoToCrewsCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
